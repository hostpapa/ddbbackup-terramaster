[zh-cn]
name = "Data Deposit Box"
auth = "Data Deposit Box Inc."
descript = "Continuous, encrypted cloud backup of the shared folders you choose.</br>After installing, give the allusers group Read access to the shared folders to back up (Read/Write to restore into them) in the TOS shared folder settings, then open the app to sign in. TOS has no per-app access, so every member of allusers gets the same access to those folders."
release_note = ""
important = "Data Deposit Box can only back up the shared folders you give it access to."

